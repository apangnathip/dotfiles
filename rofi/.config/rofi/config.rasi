configuration {
}

* {
    lightbg:                     rgba(238, 232, 213, 100%);
    foreground:                  #736b82;
    normal-foreground:           @foreground;
    urgent-foreground:           rgba(255, 129, 127, 100%);
    active-foreground:           rgba(138, 196, 255, 100%);
    selected-normal-foreground:  white;
    selected-urgent-foreground:  @selected-normal-foreground;
    selected-active-foreground:  @selected-normal-foreground;
    alternate-normal-foreground: @foreground;
    alternate-urgent-foreground: @urgent-foreground;
    alternate-active-foreground: @active-foreground;

    background:                  rgba(27, 21, 33, 90%);
    normal-background:           rgba(0, 0, 208, 0%);
    urgent-background:           @normal-background;
    active-background:           @normal-background;
    selected-normal-background:  none;
    selected-urgent-background:  none;
    selected-active-background:  none;
    alternate-normal-background: rgba(0, 0, 0, 0%);
    alternate-urgent-background: rgba(0, 0, 0, 0%);
    alternate-active-background: rgba(0, 0, 0, 0%);

    padding: 0;
    margin: 0;
    spacing: 0;
    border-color: #3f3b47;
    font: "JetBrainsMono Nerd Font Propo Medium 12";
}

window {
    background-color: @background;
    border:           1px;
    padding:          0.6em;
    border-radius:    10px;
}

message {
    border:       2px 0px 0px;
    border-color: @separatorcolor;
    padding:      1px;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border: none;
    spacing:      2px;
    scrollbar:    true;
    padding:      2px 0px 0px;
}

element {
    border:  0;
    padding: 0.1em 0.4em;
    border-radius:    10px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}

scrollbar {
    width:        2px;
    border:       0;
    handle-width: 4px;
    padding:      0;
    handle-rounded-corners: true;
}

mode-switcher {
    border:       2px 0px 0px;
    border-color: @separatorcolor;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

inputbar {
    spacing:    0;
    text-color: white;
    padding:    0.1em 0.4em;
}

case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}

entry {
    spacing:    0;
    text-color: white;
    placeholder: "";
}

prompt, button{
    spacing:    0;
    text-color: white;
}

inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em;
    text-color: white;
}

